188;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pkt" target="arp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="agg2" value="0..1" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;startArrow=diamondThin;startFill=1;startSize=14;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.312;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pkt" target="ip4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="agg3" value="0..1" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;startArrow=diamondThin;startFill=1;startSize=14;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.438;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pkt" target="ip6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="agg4" value="0..1" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;startArrow=diamondThin;startFill=1;startSize=14;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.562;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pkt" target="tcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="agg5" value="0..1" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;startArrow=diamondThin;startFill=1;startSize=14;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.688;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pkt" target="udp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="agg6" value="0..1" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;startArrow=diamondThin;startFill=1;startSize=14;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.812;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pkt" target="icmp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="agg7" value="0..1" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;startArrow=diamondThin;startFill=1;startSize=14;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.938;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pkt" target="dns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;&amp;bull; Decoders are pure functions: bytes in, optional struct out. No I/O, so 49 tests run without Npcap.&lt;br&gt;&amp;bull; Every length field is checked before reading; bad input becomes a note, never a crash.&lt;br&gt;&amp;bull; Capture is RAII and move-only, so the pcap handle is always closed exactly once.&lt;br&gt;&amp;bull; wpcap.dll is loaded by full path at run time: no admin, no PATH change, no DLL hijacking." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1010" width="640" height="100" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;dashed open arrow = uses / creates&lt;br&gt;filled diamond = DecodedPacket holds 0 or 1 of each layer&lt;br&gt;+ public &amp;nbsp; - private (file-local)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="680" y="1010" width="360" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
